<?xml version="1.0" encoding="UTF-8" ?>
<mapper namespace="mybatis.mapper.mappers.UserMapper">
    <sql id="userColumns">id,name,age</sql>
    <resultMap id="userViewMap">
        <result column="name" property="uname"/>
    </resultMap>
    <select id="findAllView" resultMap="userViewMap">
        SELECT * FROM user
    </select>
    <select id="search">
        SELECT
        <include refid="userColumns"/>
        FROM user
        <where>
            <if test="name != null">AND name = #{name}</if>
            <if test="minAge != null">AND age >= #{minAge}</if>
        </where>
    </select>
    <select id="findByAgeBand">
        SELECT
        <include refid="userColumns"/>
        FROM user
        <where>
            <choose>
                <when test="minAge != null">AND age >= #{minAge}</when>
                <otherwise>AND age >= 0</otherwise>
            </choose>
        </where>
    </select>
    <update id="updatePartial">
        UPDATE user
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="age != null">age = #{age},</if>
        </set>
        WHERE id = #{id}
    </update>
</mapper>